<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_health"
        android:textColor="@color/widget_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_activity"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_calories"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_health_calories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_steps"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_health_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_standing"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_health_standing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tertiary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_health_heart_rate_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_background">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_heart_rate"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_health_heart_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/widget_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_health_stress"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_health_sleep"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>
        <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
        <LinearLayout
            android:id="@+id/widget_health_blood_oxygen_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="84dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_background">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_blood_oxygen"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_health_blood_oxygen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/widget_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_health_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <FrameLayout
        android:id="@+id/widget_health_stress_card"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
